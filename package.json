{
  "name": "devfest-chennai-2026",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint",
    "archive": "node scripts/ingest-archive.mjs",
    "content:sync": "node scripts/sync-content.mjs",
    "md:rule": "node scripts/markdown-rule.mjs",
    "md:check": "node scripts/markdown-rule.mjs --check",
    "skills:sync": "node scripts/skills-sync.mjs",
    "skills:check": "node scripts/skills-sync.mjs --check",
    "preview": "npm run md:check && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run md:check && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "npm run md:check && opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "ci:preview": "npm run md:check && opennextjs-cloudflare build && wrangler preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "worker:ticketing:dev": "wrangler dev -c workers/ticketing/wrangler.jsonc --persist-to .wrangler/state",
    "worker:ticketing:deploy": "wrangler deploy -c workers/ticketing/wrangler.jsonc",
    "worker:ticketing:types": "wrangler types -c workers/ticketing/wrangler.jsonc --env-interface Env workers/ticketing/worker-configuration.d.ts",
    "worker:ticketing:check": "tsc -p workers/ticketing/tsconfig.json --noEmit",
    "hall:build": "NEXT_PUBLIC_HALL_ISOLATED=1 opennextjs-cloudflare build -c wrangler.hall-local.jsonc --openNextConfigPath open-next.hall.config.ts",
    "hall:dev": "wrangler dev -c wrangler.hall-local.jsonc -c workers/hall-live/wrangler.local.jsonc --ip 127.0.0.1 --port 8787 --persist-to .wrangler/hall-state",
    "hall:migrate": "wrangler d1 migrations apply hall-live-local --local -c workers/hall-live/wrangler.local.jsonc --persist-to .wrangler/hall-state",
    "hall:seed": "wrangler d1 execute hall-live-local --local -c workers/hall-live/wrangler.local.jsonc --persist-to .wrangler/hall-state --file scripts/hall-live/seed.sql",
    "hall:check": "tsc -p workers/hall-live/tsconfig.json --noEmit",
    "hall:test": "node scripts/hall-live/test.mjs",
    "hall:load": "node scripts/hall-live/load.mjs",
    "hall:bundle": "NEXT_PUBLIC_HALL_ISOLATED=1 opennextjs-cloudflare build -c wrangler.hall-local.jsonc --openNextConfigPath open-next.hall.config.ts --skipNextBuild",
    "hall:dev:load": "wrangler dev -c wrangler.hall-local.jsonc -c workers/hall-live/wrangler.load.jsonc --ip 127.0.0.1 --port 8787 --persist-to .wrangler/hall-state"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@gsap/react": "^2.1.2",
    "@next/third-parties": "^16.3.4",
    "@opennextjs/cloudflare": "^1.20.7",
    "@posthog/nextjs-config": "^1.11.1",
    "@types/three": "^0.185.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "next": "^16.3.3",
    "next-auth": "^5.0.0-beta.32",
    "posthog-js": "^1.427.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.3",
    "fontkit": "^2.0.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.135.0"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
