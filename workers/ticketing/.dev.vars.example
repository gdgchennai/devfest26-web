# Copy to `.dev.vars` — REQUIRED for `npm run worker:ticketing:dev` (with it
# unset the Worker 404s everything). In production set it as a secret:
#   npx wrangler secret put WEBHOOK_PATH -c workers/ticketing/wrangler.jsonc

# The path segment KonfHub posts to. This is the ONLY access control — pick a
# long random string for production (e.g. `openssl rand -hex 16`).
WEBHOOK_PATH=webhook
