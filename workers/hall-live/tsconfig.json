{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": [
      "@cloudflare/workers-types"
    ],
    "lib": [
      "ES2022"
    ],
    "paths": {
      "@/*": [
        "../../*"
      ]
    }
  },
  "include": [
    "index.ts",
    "gateway.ts",
    "../../lib/hall-model.ts"
  ]
}
