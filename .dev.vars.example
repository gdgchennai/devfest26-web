# Copy to `.dev.vars` (git-ignored) for `npm run preview`/`deploy` (Workers
# runtime), and mirror the same values into `.env.local` for `npm run dev`
# (Next dev server). Never commit the filled-in files.

# openssl rand -base64 32
AUTH_SECRET=

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Authorised redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://df-dev.gdghennai.in/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
