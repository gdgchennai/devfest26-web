# Copy to `.dev.vars` (git-ignored) — Wrangler's local-secrets file. It is what the
# Cloudflare `env` object is filled from, in BOTH `npm run preview` and `npm run dev`.
# Set the same values in production with `wrangler secret put <NAME>`.
#
# AUTH_* also go in `.env.local` for `npm run dev`: Auth.js reads them from
# process.env, which `next dev` fills from `.env.local`, not from here.
#
# Build-time vars (AGENDA_READY, HERO_BUTTONS) do NOT go here — they belong in the
# build environment / `.env`. See docs/environment.md.

# openssl rand -base64 32
AUTH_SECRET=

# Google Cloud Console → Credentials → OAuth 2.0 Client ID (Web application).
# Authorised redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://devfest.gdgchennai.in/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional — the Speed Typer's paragraphs. Without a key the game uses its built-in
# word list. GEMINI_MODEL overrides the default model id (see docs/environment.md).
# These are read through Cloudflare's env, so they belong HERE, not in `.env.local`.
# GEMINI_API_KEY=
# GEMINI_MODEL=

# Web Push. Private half of the VAPID key pair — pairs with
# NEXT_PUBLIC_VAPID_PUBLIC_KEY in .env.local. Generate a pair with:
#   node -e "crypto.subtle.generateKey({name:'ECDSA',namedCurve:'P-256'},true,['sign']).then(async k=>{const pub=Buffer.from(await crypto.subtle.exportKey('raw',k.publicKey)).toString('base64url');const jwk=await crypto.subtle.exportKey('jwk',k.privateKey);console.log('PUBLIC',pub);console.log('PRIVATE',jwk.d)})"
# Required for push notifications to send; the rest of the site works without it.
VAPID_PRIVATE_KEY=

# /admin (mark sessions started/ended) — comma-separated organizer emails.
# Without this nobody can reach /admin; it 403s for everyone.
# ADMIN_EMAILS=you@example.com,teammate@example.com
