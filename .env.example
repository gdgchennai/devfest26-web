# ─────────────────────────────────────────────────────────────────────────────
# Environment variables for devfest26-web
#
# Copy to `.env.local` for `npm run dev` (the Next dev server). For the
# Cloudflare Workers runtime (`npm run preview` / `npm run deploy`) the
# AUTH_* / GOOGLE secrets instead come from `.dev.vars` locally and
# `wrangler secret put` in production — see `.dev.vars.example`.
#
# Full reference: docs/environment.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Build-time ──────────────────────────────────────────────────────────────

# "true" brings /agenda and /speakers (and the hero "See agenda" CTA, the 404
# rescue grid, and the /md markdown twins) online. Anything else keeps them
# 404'd. See lib/routes.ts. Optional — defaults to off.
AGENDA_READY=false

# ── Runtime (auth) ──────────────────────────────────────────────────────────
# Required for Google sign-in + saved sessions. Without them the site runs
# fine but sign-in fails. See auth.ts and docs/accounts-and-favorites.md.

# Auth.js session-signing secret. Generate: openssl rand -base64 32
AUTH_SECRET=

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# (Web application). Authorised redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://devfest.gdgchennai.in/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Not here: GEMINI_API_KEY / GEMINI_MODEL (the Speed Typer's optional Gemini text).
# The code reads those through Cloudflare's env, which `npm run dev` fills from
# `.dev.vars`, not from this file. See .dev.vars.example and docs/environment.md.
