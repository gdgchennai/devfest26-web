{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "devfest-chennai-2026",
	"compatibility_date": "2026-08-27",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "devfest-chennai-2026"
		}
	],
	"d1_databases": [
		// Accounts + saved sessions. Create the DB and paste its id here:
		//   npx wrangler d1 create devfest-chennai-2026
		// then apply migrations locally and remotely:
		//   npx wrangler d1 migrations apply devfest-chennai-2026 --local
		//   npx wrangler d1 migrations apply devfest-chennai-2026 --remote
		{
			"binding": "DB",
			"database_name": "devfest-chennai-2026",
			"database_id": "REPLACE_WITH_D1_DATABASE_ID",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		// Use R2 incremental cache
		// See https://opennext.js.org/cloudflare/caching
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			// Create the bucket before deploying
			// You can change the bucket name if you want
			// See https://developers.cloudflare.com/workers/wrangler/commands/#r2-bucket-create
			"bucket_name": "devfest-chennai-2026-opennext-cache"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}